#!/bin/sh
# Kemas kini automatik: Blender (Flatpak, kemudian apt) dan semua Flatpak lain.
D=/var/lib/smartos; mkdir -p "$D"
{
  echo "== $(date -Is) =="
  if command -v flatpak >/dev/null 2>&1; then
    flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
    flatpak info org.blender.Blender >/dev/null 2>&1 || flatpak install -y --noninteractive flathub org.blender.Blender
    flatpak update -y --noninteractive
  fi
  apt-get update -qq && apt-get install -y -qq --only-upgrade blender
  date -Is > "$D/last-update"
} >> "$D/update.log" 2>&1
exit 0
