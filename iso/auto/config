#!/bin/sh
set -e
lb config noauto \
  --distribution trixie \
  --architectures amd64 \
  --archive-areas "main contrib non-free-firmware" \
  --binary-images iso-hybrid \
  --bootloaders "grub-efi,syslinux" \
  --debian-installer none \
  --apt-recommends false \
  --firmware-chroot true \
  --memtest none \
  --iso-application "SmartOS" \
  --iso-volume "SmartOS" \
  --iso-publisher "SmartOS" \
  --image-name smartos \
  --bootappend-live "boot=live components persistence quiet splash username=smart hostname=smartos locales=ms_MY.UTF-8 keyboard-layouts=us timezone=Asia/Kuala_Lumpur" \
  "${@}"
