{
  "layer": "top",
  "position": "bottom",
  "height": 46,
  "spacing": 8,
  "modules-left": [
    "image#start",
    "wlr/taskbar"
  ],
  "modules-right": [
    "pulseaudio",
    "network",
    "battery",
    "clock",
    "custom/power"
  ],
  "image#start": {
    "path": "/opt/smartos/shell/logo.png",
    "size": 30,
    "tooltip": false,
    "on-click": "/opt/smartos/bin/smartos-start"
  },
  "wlr/taskbar": {
    "format": "{icon} {title:.18}",
    "icon-size": 22,
    "tooltip-format": "{title}",
    "on-click": "minimize-raise",
    "on-click-middle": "close",
    "ignore-list": [
      "smartos-desktop",
      "smartos-start",
      "smartos-power"
    ]
  },
  "pulseaudio": {
    "format": "🔊 {volume}%",
    "format-muted": "🔇 senyap",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "network": {
    "format-wifi": "📶 {essid}",
    "format-ethernet": "🌐 {ifname}",
    "format-disconnected": "⚠️ tiada rangkaian",
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "foot nmtui"
  },
  "battery": {
    "format": "🔋 {capacity}%",
    "format-charging": "⚡ {capacity}%",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "/opt/smartos/shell/smartos-window.py --view power --appid smartos-power"
  }
}