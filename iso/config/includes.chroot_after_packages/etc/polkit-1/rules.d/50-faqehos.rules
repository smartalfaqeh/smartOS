// Pengguna yang sedang log masuk boleh memulakan kemas kini dan pemasangan alat AI FaqehOS tanpa kata laluan.
polkit.addRule(function(action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" && subject.local && subject.active &&
      (action.lookup("unit") == "faqehos-update.service" || action.lookup("unit") == "faqehos-ai-tools.service")) {
    return polkit.Result.YES;
  }
});
