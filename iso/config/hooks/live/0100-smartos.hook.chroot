#!/bin/sh
set -e

# ---- pengguna lalai (tanpa kata laluan) dan root dikunci
G=""
for g in audio video render input lpadmin netdev plugdev sudo adm systemd-journal; do getent group "$g" >/dev/null && G="$G,$g"; done
id smart >/dev/null 2>&1 || useradd -m -s /bin/bash -G "${G#,}" smart
passwd -d smart || true
passwd -l root || true

# ---- boot senyap: tiada banner log masuk atau motd (autologin dikonfigurasi melalui drop-in systemd)
: > /etc/motd; : > /etc/issue; : > /etc/issue.net
touch /etc/skel/.hushlogin /home/smart/.hushlogin
chown smart:smart /home/smart/.hushlogin

# ---- .bash_profile dicipta di sini (fail bertitik sering hilang semasa muat naik web)
cat > /etc/skel/.bash_profile <<'EOT'
# Mulakan sesi SmartOS (labwc + taskbar) pada konsol pertama. Sandaran: mod kiosk (cage).
if [ -z "$WAYLAND_DISPLAY" ] && [ "$(tty)" = "/dev/tty1" ]; then
  export WLR_NO_HARDWARE_CURSORS=1 WLR_RENDERER_ALLOW_SOFTWARE=1 XDG_CURRENT_DESKTOP=labwc XDG_SESSION_TYPE=wayland
  labwc > "$HOME/labwc.log" 2>&1
  [ $? -eq 0 ] && exit 0
  echo "labwc gagal. Mencuba mod kiosk (cage)..."
  cage -s -- /opt/smartos/bin/smartos-session > "$HOME/cage.log" 2>&1
  echo "Mencuba mod perisian (pixman)..."
  WLR_RENDERER=pixman LIBGL_ALWAYS_SOFTWARE=1 cage -s -- /opt/smartos/bin/smartos-session > "$HOME/cage-soft.log" 2>&1
  echo "SmartOS gagal dimulakan. Log: ~/labwc.log ~/cage.log ~/cage-soft.log ~/service.log ~/shell.log"
fi
EOT
cp /etc/skel/.bash_profile /home/smart/.bash_profile
chown smart:smart /home/smart/.bash_profile

# ---- persekitaran terminal (Claude Code / Codex)
grep -q "smartos/shell.sh" /etc/bash.bashrc || echo '[ -f /etc/smartos/shell.sh ] && . /etc/smartos/shell.sh' >> /etc/bash.bashrc

# ---- bit boleh laku (muat naik web membuangnya)
chmod +x /etc/xdg/labwc/autostart /opt/smartos/bin/* /opt/smartos/shell/*.py /opt/smartos/service/*.py 2>/dev/null || true

# ---- pakej pilihan: kegagalan tidak menggagalkan build
apt-get update -qq || true
apt-get install -y --no-install-recommends gir1.2-gtklayershell-0.1 || echo "AMARAN: gir1.2-gtklayershell-0.1 tiada; desktop menggunakan tetingkap biasa"
apt-get install -y --no-install-recommends mesa-va-drivers intel-media-va-driver vainfo || true

# ---- perkhidmatan
systemctl enable NetworkManager cups avahi-daemon bluetooth nftables zramswap earlyoom power-profiles-daemon thermald irqbalance smartos-update.timer || true
systemctl disable clamav-freshclam clamav-daemon 2>/dev/null || true   # kemas kini ClamAV dikendalikan oleh smartos-update (jimat RAM)
systemctl mask cups-browsed 2>/dev/null || true

# ---- Flathub (Smart Store) dan fail .exe dibuka dengan Wine
flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true
mkdir -p /etc/xdg
printf '[Default Applications]\napplication/x-ms-dos-executable=wine.desktop\napplication/x-msi=wine.desktop\n' > /etc/xdg/mimeapps.list

# ---- ikon, tema boot
gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
plymouth-set-default-theme smartos || echo "AMARAN: tema Plymouth tidak dijumpai"
update-initramfs -u
