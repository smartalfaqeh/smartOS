#!/bin/sh
# Dijalankan oleh labwc selepas sesi bermula.
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null
/usr/bin/python3 /opt/faqehos/service/faqehos_service.py > "$HOME/service.log" 2>&1 &
/opt/faqehos/bin/faqehos-watch >> "$HOME/health.log" 2>&1 &
( sleep 30; /opt/faqehos/bin/faqehos-claude-setup ) > /dev/null 2>&1 &
