#!/bin/sh
# Dijalankan sekali pada sistem yang DIPASANG (bukan live): tetapkan log masuk automatik ke pengguna sebenar dan buang pengguna live.
[ -d /run/live ] && exit 0
D=/var/lib/faqehos; mkdir -p "$D"
[ -f "$D/firstboot-done" ] && exit 0
U=$(awk -F: '$3>=1000 && $3<60000 && $1!="faqeh" {print $1; exit}' /etc/passwd)
[ -z "$U" ] && exit 0
H=$(getent passwd "$U" | cut -d: -f6)
mkdir -p /etc/systemd/system/getty@tty1.service.d
cat > /etc/systemd/system/getty@tty1.service.d/autologin.conf <<EOT
[Service]
ExecStart=
ExecStart=-/sbin/agetty --skip-login --nonewline --noissue --autologin $U --noclear %I \$TERM
EOT
for f in .bash_profile .hushlogin; do
  [ -e "$H/$f" ] || { cp "/etc/skel/$f" "$H/$f" 2>/dev/null || : > "$H/$f"; }
  chown "$U:$(id -gn "$U")" "$H/$f"
done
for g in audio video render input lpadmin netdev plugdev systemd-journal; do getent group "$g" >/dev/null && usermod -aG "$g" "$U"; done
L=$(. /etc/default/locale 2>/dev/null; echo "${LANG:-}")
case "$L" in ms*) P=ms ;; *) P=en ;; esac
mkdir -p "$H/.config/faqehos"; printf '{"lang":"%s"}\n' "$P" > "$H/.config/faqehos/prefs.json"
chown -R "$U:$(id -gn "$U")" "$H/.config"
userdel -r faqeh 2>/dev/null
systemctl daemon-reload
touch "$D/firstboot-done"
